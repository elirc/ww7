/// What this file does:
/// Defines the durable PostgreSQL schema for users, workflow definitions, runs, step runs, jobs, and audit events.
/// What calls it:
/// Prisma Client generation and every repository in src/repositories/**.
/// What it calls:
/// PostgreSQL through Prisma's schema compiler.
/// One thing a junior engineer would likely get wrong:
/// Modeling async execution with only one workflow table and no separate run/job records.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  ANALYST
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WorkflowTriggerType {
  EVENT
  SCHEDULE
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum WorkflowStepStatus {
  PENDING
  SKIPPED
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
}

enum WorkflowStepActionType {
  HTTP_REQUEST
  UPDATE_RUN_CONTEXT
  APPEND_RUN_EVENT
}

enum WorkflowJobStatus {
  AVAILABLE
  LEASED
  SUCCEEDED
  DEAD
}

enum AuditActorType {
  USER
  SYSTEM
}

model User {
  id               String               @id @default(cuid())
  email            String               @unique
  name             String
  passwordHash     String
  role             UserRole
  createdWorkflows WorkflowDefinition[] @relation("WorkflowCreatedBy")
  updatedWorkflows WorkflowDefinition[] @relation("WorkflowUpdatedBy")
  initiatedRuns    WorkflowRun[]        @relation("WorkflowRunInitiatedBy")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model WorkflowDefinition {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  description     String?
  status          WorkflowStatus      @default(DRAFT)
  triggerType     WorkflowTriggerType
  eventName       String?
  cronExpression  String?
  nextScheduledAt DateTime?
  createdByUserId String
  updatedByUserId String
  createdBy       User                @relation("WorkflowCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy       User                @relation("WorkflowUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  steps           WorkflowStep[]
  runs            WorkflowRun[]
  auditEvents     WorkflowAuditEvent[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, triggerType])
}

model WorkflowStep {
  id             String                 @id @default(cuid())
  workflowId     String
  position       Int
  name           String
  actionType     WorkflowStepActionType
  config         Json
  condition      Json?
  maxRetries     Int                    @default(2)
  timeoutSeconds Int?
  workflow       WorkflowDefinition     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepRuns       WorkflowStepRun[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([workflowId, position])
}

model WorkflowRun {
  id                String             @id @default(cuid())
  workflowId        String
  initiatedByUserId String?
  status            WorkflowRunStatus  @default(QUEUED)
  triggerSource     String
  triggerPayload    Json?
  contextSnapshot   Json               @default("{}")
  startedAt         DateTime?
  finishedAt        DateTime?
  workflow          WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  initiatedBy       User?              @relation("WorkflowRunInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  stepRuns          WorkflowStepRun[]
  jobs              WorkflowJob[]
  auditEvents       WorkflowAuditEvent[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([workflowId, status])
}

model WorkflowStepRun {
  id               String             @id @default(cuid())
  runId            String
  stepId           String
  position         Int
  status           WorkflowStepStatus @default(PENDING)
  attempts         Int                @default(0)
  conditionMatched Boolean?
  lastError        String?
  inputSnapshot    Json?
  outputSnapshot   Json?
  startedAt        DateTime?
  finishedAt       DateTime?
  run              WorkflowRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  step             WorkflowStep       @relation(fields: [stepId], references: [id], onDelete: Restrict)
  jobs             WorkflowJob[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([runId, position])
}

model WorkflowJob {
  id          String            @id @default(cuid())
  runId       String
  stepRunId   String            @unique
  /// SENIOR NOTE: job state is separate from step-run state so workers can lease, retry, and dead-letter without losing execution history.
  status      WorkflowJobStatus @default(AVAILABLE)
  readyAt     DateTime          @default(now())
  leasedUntil DateTime?
  leaseToken  String?
  attempts    Int               @default(0)
  maxAttempts Int
  lastError   String?
  run         WorkflowRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepRun     WorkflowStepRun   @relation(fields: [stepRunId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, readyAt])
}

model WorkflowAuditEvent {
  id         String              @id @default(cuid())
  workflowId String?
  runId      String?
  actorType  AuditActorType
  actorId    String?
  kind       String
  message    String
  metadata   Json?
  workflow   WorkflowDefinition? @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  run        WorkflowRun?        @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now())

  @@index([workflowId, kind])
  @@index([runId, kind])
}

